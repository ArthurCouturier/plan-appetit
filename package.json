{
  "name": "plan-appetit",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build-prod": "tsc -b && vite build --mode production && npx cap sync ios && npx cap open ios",
    "build-local": "tsc -b && vite build --mode development && npx cap sync ios && npx cap open ios",
    "build-android-local": "tsc -b && vite build --mode development && npx cap sync android && npm run fix:agp",
    "build-android-prod": "tsc -b && vite build --mode production && npx cap sync android && npm run fix:agp",
    "mobile-build": "npm run build && npx cap sync ios && npx cap open ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "fix:agp": "sed -i '' \"s/classpath 'com.android.tools.build:gradle:[0-9.]*'/classpath 'com.android.tools.build:gradle:8.13.2'/\" android/capacitor-cordova-android-plugins/build.gradle",
    "cap:sync": "npx cap sync && npm run fix:agp",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:ios:live": "npx cap run ios --livereload --external",
    "cap:android": "npm run build && npx cap sync android && npm run fix:agp && npx cap open android",
    "cap:android:live": "npx cap run android --livereload --external",
    "cap:build": "npm run build && npx cap sync && npm run fix:agp",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@capacitor-community/facebook-login": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor-firebase/messaging": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/native-purchases": "^8.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@material-tailwind/react": "^2.1.10",
    "@number-flow/react": "^0.5.5",
    "@stripe/stripe-js": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.90.21",
    "@vercel/analytics": "^1.4.1",
    "capacitor-plugin-app-tracking-transparency": "^3.0.0",
    "firebase": "^12.13.0",
    "framer-motion": "^12.35.2",
    "posthog-js": "^1.281.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/ui": "^4.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^27.0.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^4.0.3"
  }
}
